@model CordovaINFASS.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_HomeLayout";
}

<div class="auth-container">
    <div class="auth-wrapper">
        <!-- Left Section - Welcome -->
        <div class="auth-welcome">
            <div class="welcome-content">
                <h1>Welcome to website</h1>
                <p>We are thrilled to have you. Explore our tailored solutions, expert insights, and community resources built to help you succeed. Your journey begins here.</p>
            </div>
            <div class="welcome-decoration">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
                <div class="shape shape-4"></div>
                <div class="shape shape-5"></div>
            </div>
        </div>

        <!-- Right Section - Login Form -->
        <div class="auth-form-container">
            <div class="form-wrapper">
                <h2>USER LOGIN</h2>

                <form id="loginForm" method="post" asp-action="Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <input type="email" asp-for="Email" class="form-control" placeholder="Email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="password" asp-for="Password" class="form-control" placeholder="Password" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group checkbox-group">
                        <input type="checkbox" asp-for="RememberMe" id="RememberMe" />
                        <label for="RememberMe">Remember me?</label>
                        <a href="#" class="forgot-password">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-login">LOGIN</button>
                </form>

                <p class="register-link">
                    Don't have an account? <a asp-action="Register">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $("#loginForm").on("submit", function(e) {
            e.preventDefault();

            var $form = $(this);

            $.ajax({
                type: "POST",
                url: $form.attr("action"),
                data: $form.serialize(),
                success: function(response) {
                    if (response.success) {
                        // Show a quick, modern toast notification before redirecting
                        Swal.fire({
                            title: 'Welcome Back!',
                            text: 'Logging you in...',
                            icon: 'success',
                            showConfirmButton: false,
                            timer: 1500,
                            timerProgressBar: true
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        var errorHtml = '<ul style="text-align: left;">' +
                            response.errors.map(err => `<li>${err}</li>`).join('') +
                            '</ul>';

                        Swal.fire({
                            title: 'Login Failed',
                            html: errorHtml,
                            icon: 'error',
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'Ok'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({
                        title: 'System Error',
                        text: 'An unexpected connection error occurred. Please try again.',
                        icon: 'error',
                        confirmButtonColor: '#d33'
                    });
                }
            });
        });
    });
</script>