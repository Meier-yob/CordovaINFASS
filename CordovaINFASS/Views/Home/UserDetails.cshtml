@model CordovaINFASS.Models.User
@{
    ViewData["Title"] = "User Details";
    Layout = "_HomeLayout";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">User Details</h5>
                    <a class="btn btn-light btn-sm" asp-controller="Home" asp-action="AccountPage">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </a>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">User ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Model.FirstName</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@Model.LastName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Created At (UTC)</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                    </dl>
                </div>
                <div class="card-footer text-end">
                    <a class="btn btn-outline-primary me-2" asp-controller="Home" asp-action="AccountPage">Back</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="AccountPage">Manage</a>
                </div>
            </div>
        </div>
    </div>
</div>