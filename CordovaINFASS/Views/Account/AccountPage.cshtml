@{
    ViewData["Title"] = "Manage Accounts";
    Layout = "_HomeLayout";
}

<div class="container py-5">
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4">Account Management</h2>
        <button class="btn btn-primary" id="btnNewUser"><i class="fas fa-plus me-1"></i> New User</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered" id="usersTable">
            <thead class="table-secondary">
                <tr>
                    <th style="width:60px">ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th style="width:140px">Created At</th>
                    <th style="width:200px">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal for Create / Edit -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="userForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="userModalTitle">New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="UserId" name="id" value="0" />

                    <div class="mb-3">
                        <label for="FirstName" class="form-label">First Name</label>
                        <input id="FirstName" name="firstName" class="form-control" required maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label for="LastName" class="form-label">Last Name</label>
                        <input id="LastName" name="lastName" class="form-control" required maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label for="Email" class="form-label">Email</label>
                        <input id="Email" name="email" type="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">Password</label>
                        <input id="Password" name="password" type="password" class="form-control" placeholder="Leave blank to keep existing password" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSaveUser" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@section Scripts {
<script>
    (function () {
        const $tableBody = $('#usersTable tbody');
        const userModalEl = document.getElementById('userModal');
        const userModal = new bootstrap.Modal(userModalEl);
        const $userForm = $('#userForm');

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }

        function loadUsers() {
            $.get('/Account/GetUsers').done(function (res) {
                if (!res.success) {
                    Swal.fire('Error', 'Failed to load users.', 'error');
                    return;
                }
                $tableBody.empty();
                res.data.forEach(u => {
                    const row = `<tr data-id="${u.id}">
                        <td>${u.id}</td>
                        <td>${u.firstName}</td>
                        <td>${u.lastName}</td>
                        <td>${u.email}</td>
                        <td>${u.createdAt}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info btn-details me-1">Details</button>
                            <button class="btn btn-sm btn-outline-primary btn-edit me-1">Edit</button>
                            <button class="btn btn-sm btn-outline-danger btn-delete">Delete</button>
                        </td>
                    </tr>`;
                    $tableBody.append(row);
                });
            }).fail(function () {
                Swal.fire('Error', 'Connection error while loading users.', 'error');
            });
        }

        function clearForm() {
            $('#UserId').val(0);
            $('#FirstName').val('');
            $('#LastName').val('');
            $('#Email').val('');
            $('#Password').val('');
        }

        // New user
        $('#btnNewUser').on('click', function () {
            clearForm();
            $('#userModalTitle').text('New User');
            userModal.show();
        });

        // Details button navigates to details view
        $tableBody.on('click', '.btn-details', function () {
            const id = $(this).closest('tr').data('id');
            if (id) window.location.href = '/Account/UserDetails/' + id;
        });

        // Edit button
        $tableBody.on('click', '.btn-edit', function () {
            const $tr = $(this).closest('tr');
            const id = $tr.data('id');

            $.get('/Account/GetUsers').done(function (res) {
                if (!res.success) { Swal.fire('Error','Failed to load user.','error'); return; }
                const user = res.data.find(x => x.id === id);
                if (!user) { Swal.fire('Error','User not found.','error'); return; }

                $('#UserId').val(user.id);
                $('#FirstName').val(user.firstName);
                $('#LastName').val(user.lastName);
                $('#Email').val(user.email);
                $('#Password').val('');
                $('#userModalTitle').text('Edit User');
                userModal.show();
            });
        });

        // Delete button
        $tableBody.on('click', '.btn-delete', function () {
            const $tr = $(this).closest('tr');
            const id = $tr.data('id');
            Swal.fire({
                title: 'Confirm delete',
                text: 'Delete user #' + id + '?',
                icon: 'warning',
                showCancelButton: true
            }).then(result => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Account/DeleteUser',
                    method: 'POST',
                    data: { id: id, __RequestVerificationToken: getAntiForgeryToken() }
                }).done(function (res) {
                    if (res.success) {
                        loadUsers();
                        Swal.fire('Deleted', res.message || 'User deleted.', 'success');
                    } else {
                        Swal.fire('Error', (res.errors && res.errors.join('\n')) || 'Delete failed.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'Connection error while deleting user.', 'error');
                });
            });
        });

        // Save (create or update)
        $userForm.on('submit', function (e) {
            e.preventDefault();
            const id = parseInt($('#UserId').val() || '0', 10);
            const firstName = $('#FirstName').val();
            const lastName = $('#LastName').val();
            const email = $('#Email').val();
            const password = $('#Password').val();

            if (!firstName || !lastName || !email) {
                Swal.fire('Validation', 'First name, last name and email are required.', 'warning');
                return;
            }

            if (id === 0) {
                $.ajax({
                    url: '/Account/CreateUser',
                    method: 'POST',
                    data: {
                        FirstName: firstName,
                        LastName: lastName,
                        Email: email,
                        Password: password || 'changeme',
                        ConfirmPassword: password || 'changeme',
                        __RequestVerificationToken: getAntiForgeryToken()
                    }
                }).done(function (res) {
                    if (res.success) {
                        userModal.hide();
                        loadUsers();
                        Swal.fire('Success', 'User created.', 'success');
                    } else {
                        Swal.fire('Error', (res.errors && res.errors.join('\n')) || 'Create failed.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'Connection error while creating user.', 'error');
                });
            } else {
                $.ajax({
                    url: '/Account/UpdateUser',
                    method: 'POST',
                    data: {
                        id: id,
                        firstName: firstName,
                        lastName: lastName,
                        email: email,
                        password: password,
                        __RequestVerificationToken: getAntiForgeryToken()
                    }
                }).done(function (res) {
                    if (res.success) {
                        userModal.hide();
                        loadUsers();
                        Swal.fire('Success', 'User updated.', 'success');
                    } else {
                        Swal.fire('Error', (res.errors && res.errors.join('\n')) || 'Update failed.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'Connection error while updating user.', 'error');
                });
            }
        });

        $(function () {
            loadUsers();
        });
    })();
</script>
}
